{
  "model": {
    "url": "http://127.0.0.1:8088",
    "key_file": "~/models/.llama-key",
    "timeout": 900
  },
  "prompts_dir": "~/fisherman-private/prompts",
  "prompt_vars": {
    "principal": "Alice"
  },
  "pipeline": {
    "threshold": 0.5,
    "quick_examples": true,
    "window_tokens": 250,
    "stride_tokens": 200,
    "max_quick_tokens": 800,
    "max_reason_tokens": 1200,
    "reason_budget": 1400,
    "max_item_chars": 4000,
    "principal_aliases": [
      "Ali"
    ],
    "rule_page_pattern": "\\b(rules|policies):\\w",
    "context_ref_pattern": "#(\\d{3,6})\\b",
    "steps": [
      "quick",
      "reason",
      "claims"
    ]
  },
  "destinations": {
    "github_owners": [
      "my-org",
      "my-user"
    ],
    "hosts": [
      "redmine.example.com"
    ]
  },
  "sources": [
    {
      "type": "jsonl",
      "name": "inbox",
      "path": "~/fisherman-private/inbox.jsonl"
    }
  ],
  "records": {
    "type": "none"
  },
  "alerts": {
    "type": "jsonl",
    "path": "~/fisherman-private/alerts.jsonl"
  },
  "state_file": "~/.local/state/fisherman/state.json"
}
