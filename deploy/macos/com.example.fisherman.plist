<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fisherman as a LaunchDaemon: starts at boot, runs without a login, restarts on failure.
  Replace USER and the paths, then:
    sudo cp com.example.fisherman.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.example.fisherman.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.example.fisherman.plist
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.fisherman</string>
  <key>UserName</key><string>USER</string>
  <key>WorkingDirectory</key><string>/Users/USER/fisherman</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>-m</string><string>fisherman</string>
    <string>run</string>
    <string>--config</string><string>/Users/USER/fisherman-private/config.json</string>
    <string>--interval</string><string>600</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/USER/fisherman-private/fisherman.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/fisherman-private/fisherman.log</string>
</dict></plist>
