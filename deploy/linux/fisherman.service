# Install as /etc/systemd/system/fisherman.service, adjust User and paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now fisherman
[Unit]
Description=Fisherman prompt-injection scanner
After=network-online.target llama-server.service
Wants=network-online.target

[Service]
User=fisherman
WorkingDirectory=/opt/fisherman
ExecStart=/usr/bin/python3 -m fisherman run --config /etc/fisherman/config.json --interval 600
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fisherman
StateDirectory=fisherman

[Install]
WantedBy=multi-user.target
