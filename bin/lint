#!/usr/bin/env bash
# Runs every linter and both packages' specs with coverage, as CI does.
# Set up once: pip install -r requirements-lint.txt -e . -e plugins/fisherman-redmine
set -euo pipefail
cd "$(dirname "$0")/.."

PLUGIN=plugins/fisherman-redmine

ruff check fisherman tests "$PLUGIN"
ruff format --check fisherman tests "$PLUGIN"
mypy
pydoclint fisherman "$PLUGIN/fisherman_redmine"

coverage run -m unittest discover -s tests -t .
coverage report

(cd "$PLUGIN" && coverage run -m unittest discover -s tests -t . && coverage report)
