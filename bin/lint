#!/usr/bin/env bash
# Runs every linter and the specs with coverage, as CI does.
# Install the pinned tools first: pip install -r requirements-lint.txt
set -euo pipefail
cd "$(dirname "$0")/.."

ruff check fisherman tests
ruff format --check fisherman tests
mypy
pydoclint fisherman
coverage run -m unittest discover -s tests -t .
coverage report
