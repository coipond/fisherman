{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements-lint\\.txt$/"
    ]
  },
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "setuptools 83+ requires Python 3.10; hold the build backend while Python 3.9 (the macOS system Python) is supported",
      "matchPackageNames": [
        "setuptools"
      ],
      "allowedVersions": "<83"
    }
  ]
}
