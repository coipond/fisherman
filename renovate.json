{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)requirements-lint\\.txt$/"]
  },
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "labels": [
    "dependencies"
  ]
}
